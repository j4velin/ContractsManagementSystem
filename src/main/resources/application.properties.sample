server.port=8081
server.use-forward-headers=true
server.forward-headers-strategy=native
server.tomcat.protocol-header=x-forwarded-proto
spring.data.mongodb.database=contracts
spring.data.mongodb.uri=TODO
spring.data.mongodb.auto-index-creation=true

# Secret for signing remember-me cookies. Use a long random value and keep it stable, otherwise
# remembered logins are invalidated on every restart. If unset, a random key is generated at startup.
#contracts.remember-me.key=
