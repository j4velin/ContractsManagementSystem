# Copy to .env and adjust. docker compose reads .env automatically.

# Port on the host for the app
APP_PORT=8080

# Secret for signing remember-me cookies, e.g. generated with: openssl rand -hex 32
# Keep it stable, otherwise remembered logins are invalidated whenever the app restarts.
REMEMBER_ME_KEY=

# How X-Forwarded-* headers from a reverse proxy are handled: "native" (default) makes redirects use the
# proxy's scheme and host, e.g. https. Use "none" if the app is reachable directly, without a proxy.
FORWARD_HEADERS_STRATEGY=native

# Time zone of the app (an IANA name, e.g. Europe/Berlin or UTC). Today's date in this time zone decides which
# contracts are active and is the basis for the cancel-by dates.
TIMEZONE=Europe/Berlin

# Which published image to run: "latest" (the newest released version) or a specific one like "1.2.0"
APP_VERSION=latest

# Memory limits: the app's maximum Java heap and MongoDB's cache size in GB. The defaults suit a small server
APP_MAX_HEAP=256m
MONGO_CACHE_GB=0.25
